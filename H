        mt.__namecall = newcclosure(function(self, ...)
            local method = getnamecallmethod()
            local args   = {...}
            if FastShootEnabled and method == "InvokeServer" and tostring(self) == "Shoot" then
                local power = args[4]
                if typeof(power) ~= "number" or power < 1 then return nil end
            end
            return old(self, ...)
        end)
        mt.__FastShootHooked = true
        setreadonly(mt, true)
    end
end

