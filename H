local function updateQuestTools()
    AssignedTools = {}
    local currentTools = {}
    local character = LocalPlayer.Character
    local function scan(parent)
        if not parent then return end
        for _, item in ipairs(parent:GetChildren()) do
            if item:IsA("Tool") and (string.match(item.ToolTip, "%d+/%d+") or string.find(item.ToolTip, "Finished!")) then
                table.insert(currentTools, item)
            end
        end
    end
    scan(LocalPlayer:FindFirstChild("Backpack"))
    scan(character)
    local activeQuests = {SelectedQuest1, SelectedQuest2, SelectedQuest3, SelectedQuest4, SelectedQuest5}
    for _, tool in ipairs(currentTools) do
        local nameLower = string.lower(tool.Name)
        for _, questDisplayName in ipairs(activeQuests) do
            local data = QuestData[questDisplayName]
            if data and not AssignedTools[questDisplayName] then
                local targetToolLower = string.lower(data.tool)
                if string.find(nameLower, targetToolLower, 1, true) then
                    AssignedTools[questDisplayName] = tool
                    break
                end
            end
        end
    end
end

