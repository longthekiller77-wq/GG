-- แก้ไข: ใช้ระบบ Raycast แบบใหม่ แม่นยำกว่าและไม่บัคเรื่องกำแพง
local function clearPath(part)
    local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    
    local dir = part.Position - hrp.Position
    if dir.Magnitude <= 0 then return true end

    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    
    local ignoreList = {player.Character}
    local mobs = workspace:FindFirstChild("Mobs")
    if mobs then table.insert(ignoreList, mobs) end
    
    raycastParams.FilterDescendantsInstances = ignoreList

    local result = workspace:Raycast(hrp.Position, dir, raycastParams)
    
    -- ถ้าชนอะไรก็ตามที่เดินทะลุไม่ได้ (CanCollide = true) แสดงว่ามีสิ่งกีดขวาง
    if result and result.Instance and result.Instance.CanCollide then
        return false
    end
    
    return true
end

local function getClosestAssistMob()
    local hrp  = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    local mobs = workspace:FindFirstChild("Mobs")
    if not hrp or not mobs then return nil end
    
    local best, bestDist = nil, FastShootDistance
    for _, c in ipairs(mobs:GetDescendants()) do
        if c.Name == "HumanoidRootPart" then
            local model = c.Parent
            local hum   = model and model:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 and not table.find(friendlyMobs, model.Name) then
                local d = (c.Position - hrp.Position).Magnitude
                if d <= FastShootDistance and d < bestDist and clearPath(c) then
                    bestDist = d
                    best = c
                end
            end
        end
    end
    return best
end

