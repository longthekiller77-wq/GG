local MineEnabled  = false
local SelectedOre  = nil
local lastTarget   = nil

local function GetOreNames()
    local names = {}
    local added = {}
    local oresFolder = workspace:FindFirstChild("Ores")
    if not oresFolder then return {"None"} end
    for _, area in pairs(oresFolder:GetChildren()) do
        for _, node in pairs(area:GetChildren()) do
            local partFolder = node:FindFirstChild("Part")
            if partFolder then
                for _, ore in pairs(partFolder:GetChildren()) do
                    if (ore:IsA("BasePart") or ore:IsA("Model")) and not added[ore.Name] then
                        added[ore.Name] = true
                        table.insert(names, ore.Name)
                    end
                end
            end
        end
    end
    table.sort(names)
    if #names == 0 then table.insert(names, "None") end
    return names
end

local function GetOresByName(name)
    local list = {}
    local oresFolder = workspace:FindFirstChild("Ores")
    if not oresFolder then return list end
    for _, area in pairs(oresFolder:GetChildren()) do
        for _, node in pairs(area:GetChildren()) do
            local partFolder = node:FindFirstChild("Part")
            if partFolder then
                local ore = partFolder:FindFirstChild(name)
                if ore then
                    if ore:IsA("BasePart") then
                        table.insert(list, ore)
                    elseif ore:IsA("Model") then
                        local part = ore:FindFirstChildWhichIsA("BasePart")
                        if part then table.insert(list, part) end
                    end
                end
            end
        end
    end
    return list
end

local function teleportLookAt(hrp, target)
    local direction = (target.Position - hrp.Position).Unit
    local pos  = target.Position - direction * 3 + Vector3.new(0,0,3)
    local look = Vector3.new(target.Position.X, pos.Y, target.Position.Z)
    hrp.CFrame  = CFrame.lookAt(pos, look)
end

