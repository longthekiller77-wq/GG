local function startFlying()
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local torso = char:WaitForChild("Torso", 5) or char:WaitForChild("UpperTorso", 5)
    local humanoid = char:WaitForChild("Humanoid", 5)
    if not torso or not humanoid then return end
    if torso:FindFirstChild("FlyGyro") then torso.FlyGyro:Destroy() end
    if torso:FindFirstChild("FlyVelocity") then torso.FlyVelocity:Destroy() end
    local bg = Instance.new("BodyGyro")
    bg.Name = "FlyGyro"
    bg.P = 9e4
    bg.maxTorque = Vector3.new(9e9, 9e9, 9e9)
    bg.cframe = torso.CFrame
    bg.Parent = torso
    local bv = Instance.new("BodyVelocity")
    bv.Name = "FlyVelocity"
    bv.velocity = Vector3.new(0, 0, 0)
    bv.maxForce = Vector3.new(9e9, 9e9, 9e9)
    bv.Parent = torso
    humanoid.PlatformStand = true
    task.spawn(function()
        while getgenv().Flying and char and torso.Parent and humanoid.Parent do
            task.wait()
            local camera = workspace.CurrentCamera
            local moveDirection = humanoid.MoveDirection
            if moveDirection.Magnitude > 0 then
                local camRelative = camera.CFrame:VectorToObjectSpace(moveDirection)
                local flyDirection = (camera.CFrame.LookVector * -camRelative.Z) + (camera.CFrame.RightVector * camRelative.X)
                bv.velocity = flyDirection.Unit * FlySpeed
            else
                bv.velocity = Vector3.new(0, 0, 0)
            end
            bg.cframe = camera.CFrame
        end
        bg:Destroy()
        bv:Destroy()
        if humanoid then humanoid.PlatformStand = false end
    end)
end

